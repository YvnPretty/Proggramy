<?php
declare(strict_types=1);

$err = ['c' => '', 'd' => '', 'm' => ''];
$old = ['c' => '', 'd' => '', 'm' => ''];
$res = null;

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $old['c'] = $_POST['cantidad_libros'] ?? '';
    $old['d'] = $_POST['dias_retraso'] ?? '';
    $old['m'] = $_POST['mismo_dia'] ?? '';

    if ($old['c'] === '' || !ctype_digit($old['c'])) $err['c'] = 'Número inválido.';
    if ($old['d'] === '' || !ctype_digit($old['d'])) $err['d'] = 'Número inválido.';
    if ($old['m'] !== 's' && $old['m'] !== 'n') $err['m'] = 'Selecciona una opción.';

    if (!array_filter($err)) {
        $c = (int)$old['c'];
        $d = (int)$old['d'];

        $base = $c * 5;
        $rec = $c * $d * 2;
        $sub = $base + $rec;
        $desc = $old['m'] === 's' ? $sub * .20 : 0;
        $tot = $sub - $desc;

        $res = [
            'base' => number_format($base, 2, '.', ','),
            'rec'  => number_format($rec, 2, '.', ','),
            'sub'  => number_format($sub, 2, '.', ','),
            'desc' => number_format($desc, 2, '.', ','),
            'tot'  => number_format($tot, 2, '.', ','),
        ];
    }
}
?>
